# LM Studio Configuration
# LM Studio runs locally and provides an OpenAI-compatible API

# LM Studio base URL (default: http://localhost:1234/v1)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# API key (LM Studio doesn't require one by default, but kept for compatibility)
LM_STUDIO_API_KEY=lm-studio

# Council Models (comma-separated list of model names loaded in LM Studio)
# These should match the exact model names shown in LM Studio
# Example: COUNCIL_MODELS=mistral-7b-instruct,llama-2-13b-chat,neural-chat-7b
COUNCIL_MODELS=model-1,model-2,model-3

# Chairman Model (model that synthesizes the final answer)
# This should also be loaded in LM Studio
# If not specified, defaults to the first council model
CHAIRMAN_MODEL=model-1

# Backend API URL (for Streamlit to connect to)
BACKEND_URL=http://localhost:8001
